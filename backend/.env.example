DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# Vision Provider - xử lý ảnh (chọn openai hoặc gemini)
VISION_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Facebook Messenger Bot (tạo tại https://developers.facebook.com)
MESSENGER_VERIFY_TOKEN=deepseek_bot_verify_2026
MESSENGER_PAGE_ACCESS_TOKEN=EAAxxx-your-page-access-token
MESSENGER_APP_SECRET=abc123-your-app-secret
